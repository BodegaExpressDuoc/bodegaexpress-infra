# Copiar como .env y completar. El .env no se sube al repositorio.
USUARIOS_DB_USERNAME=cambiar_por_tu_usuario
USUARIOS_DB_PASSWORD=cambiar_por_tu_clave
ARTICULOS_DB_USERNAME=cambiar_por_tu_usuario
ARTICULOS_DB_PASSWORD=cambiar_por_tu_clave
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRACION_MINUTOS=60

# Puertos de tu equipo (cámbialos si están ocupados)
USUARIOS_HOST_PORT=8081
ARTICULOS_HOST_PORT=8082
BUSQUEDA_HOST_PORT=8083

# Dirección donde se publican los puertos.
# Local: 127.0.0.1 (solo tu equipo). EC2: 0.0.0.0 (el grupo de seguridad decide quién entra).
HOST_BIND_ADDRESS=127.0.0.1

# Solo en la EC2: imágenes de ECR (en local se usan las imágenes construidas en tu equipo).
# USUARIOS_IMAGE=<id-cuenta>.dkr.ecr.us-east-1.amazonaws.com/ms-usuarios:latest
# ARTICULOS_IMAGE=<id-cuenta>.dkr.ecr.us-east-1.amazonaws.com/ms-articulos:latest
# BUSQUEDA_IMAGE=<id-cuenta>.dkr.ecr.us-east-1.amazonaws.com/ms-busqueda:latest
